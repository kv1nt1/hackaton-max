# --- База данных ---
# В Docker БД создаётся с этими же именем/пользователем/паролем.
# Если пароль содержит # или пробелы, заключи его в одинарные кавычки.
# Символ $ в пароле в docker compose пишется как $$.
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=

# Только для запуска БЕЗ Docker (python run_bot.py на своей машине):
DB_HOST=localhost
DB_PORT=5432

# --- Бот ---
MAX_BOT_TOKEN=
# MAX_NO_PROXY=1

# --- Необязательно: настройки Docker ---
# DB_HOST_PORT=5433        # порт Postgres на твоей машине (для DBeaver, psql и т.п.)
# PGADMIN_PORT=5050        # http://localhost:5050
# PGADMIN_EMAIL=admin@admin.com
# PGADMIN_PASSWORD=admin
